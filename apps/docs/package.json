{
  "name": "docs",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 4002",
    "build": "vite build",
    "start": "vite preview --port 4002",
    "lint": "eslint --max-warnings 0",
    "format": "prettier --check . --ignore-path ../../.gitignore --ignore-path .prettierignore",
    "check-types": "tsc --noEmit",
    "clean": "git clean -xdf .cache .source .tanstack .turbo dist node_modules"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.39",
    "@tanstack/react-start": "^1.168.58",
    "fumadocs-core": "16.15.14",
    "fumadocs-mdx": "15.4.4",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.15.14",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^25.9.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vidcastx/eslint-config": "workspace:*",
    "@vidcastx/prettier": "workspace:*",
    "@vidcastx/typescript-config": "workspace:*",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^7.3.6",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "prettier": "@vidcastx/prettier"
