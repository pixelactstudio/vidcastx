# ==============================================================================
# INFRASTRUCTURE (Used by Docker Compose)
# ==============================================================================

# PostgreSQL
DB_USER=admin
DB_PASSWORD=password
DB_NAME=vidcastx

# MinIO (Local S3)
MINIO_USER=admin
MINIO_PASSWORD=password

# ==============================================================================
# SHARED APPLICATION CONFIG (Used by API, Workers, Dashboard)
# ==============================================================================

# Database Connection (Drizzle)
# In local dev, host is 'localhost'. Inside Docker containers, use 'postgres'
DATABASE_URL="postgresql://admin:password@localhost:5432/vidcastx"

# Redis Connection (BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=

# Object Storage (S3 Compatible - AWS / Hetzner / MinIO)
# For local MinIO: http://localhost:9000
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="admin"
S3_SECRET_ACCESS_KEY="password"
S3_BUCKET_NAME="vidcastx-bucket"
S3_FORCE_PATH_STYLE="true" # Required for MinIO. Set to false for AWS/Hetzner

# ==============================================================================
# API SERVER (apps/api)
# ==============================================================================

PORT=4001
JWT_SECRET="super_secret_random_string_for_signing_tokens"

# ==============================================================================
# WORKER TRANSCODER (workers/transcoder)
# ==============================================================================

TRANSCODER_SECRET="transcoder_shared_secret"
TRANSCODER_ID="worker-transcoder"
API_URL="http://localhost:4001"
HW_ENCODER="libx264" # libx264 (CPU) | h264_nvenc (NVIDIA) | h264_videotoolbox (macOS)
CONCURRENT_JOBS=2

# ==============================================================================
# APP (apps/app — TanStack Start, runs on :4000)
# ==============================================================================

VITE_APP_URL="http://localhost:4000"
VITE_API_URL="http://localhost:4001"

# ==============================================================================
# ANALYTICS (packages/analytics)
# ==============================================================================

NEXT_PUBLIC_POSTHOG_KEY="phc_your_posthog_key"
NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"
# NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"  # Optional

# ==============================================================================
# SEO (packages/seo)
# ==============================================================================

ENVIRONMENT="development" # development | production
# PRODUCTION_URL="vidcastx.com"  # Required in production (no protocol)

# ==============================================================================
# AUTHENTICATION (packages/auth)
# ==============================================================================

BETTER_AUTH_SECRET="supersecret"
BETTER_AUTH_URL="http://localhost:4001"

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Discord OAuth
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
