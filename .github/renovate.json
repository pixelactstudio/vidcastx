{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommits", ":maintainLockFilesWeekly", "group:allNonMajor"],
  "baseBranchPatterns": ["dev"],
  "timezone": "UTC",
  "schedule": ["before 9am on monday"],
  "labels": ["dependencies"],
  "rangeStrategy": "bump",
  "minimumReleaseAge": "3 days",
  "internalChecksFilter": "strict",
  "prCreation": "not-pending",
  "dependencyDashboardTitle": "📦 Dependency Dashboard",
  "vulnerabilityAlerts": {
    "labels": ["dependencies", "security"]
  },
  "osvVulnerabilityAlerts": true,
  "lockFileMaintenance": {
    "automerge": true
  },
  "packageRules": [
    {
      "description": "One weekly PR for every minor and patch update, merged once CI passes",
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "description": "Majors wait for a tick on the dependency dashboard",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true,
      "labels": ["dependencies", "major-update"]
    },
    {
      "description": "GitHub Actions in one PR, majors included: CI exercises every action on the PR itself",
      "matchManagers": ["github-actions"],
      "groupName": "github actions",
      "groupSlug": "github-actions",
      "dependencyDashboardApproval": false
    },
    {
      "description": "better-auth is held on ~1.6 (see tasks/todo.md); keep its bump out of the weekly batch so it can't block it",
      "matchPackageNames": ["better-auth", "/^@better-auth\\//"],
      "groupName": "better-auth",
      "groupSlug": "better-auth",
      "automerge": false
    },
    {
      "description": "Workspace packages are versioned in-repo",
      "matchPackageNames": ["/^@vidcastx\\//"],
      "enabled": false
    }
  ]
}
