{
  "name": "@vidcastx/database",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./env": "./src/env.ts",
    "./schema/*": "./src/schema/*.ts",
    "./client": "./src/client.ts",
    "./utils/*": "./src/utils/*.ts"
  },
  "scripts": {
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "check-types": "tsc --noEmit --emitDeclarationOnly false",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "with-env": "dotenv -e ../../.env --"
  },
  "prettier": "@vidcastx/prettier",
  "devDependencies": {
    "@types/node": "^25.9.8",
    "@types/pg": "^8.23.1",
    "@vidcastx/eslint-config": "workspace:*",
    "@vidcastx/prettier": "workspace:*",
    "@vidcastx/typescript-config": "workspace:*",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5"
  },
  "dependencies": {
    "@t3-oss/env-core": "^0.13.11",
    "drizzle-orm": "^0.45.3",
    "drizzle-zod": "^0.8.3",
    "nanoid": "^5.1.16",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  }
}
